# ── Global LLM Configuration ──────────────────────────────────────────────────
# Primary global variables: works with any link and OpenAI-compatible endpoint
API_KEY=your_api_key_here
URL=https://openrouter.ai/api/v1
MODEL=meta-llama/llama-3.3-70b-instruct

# Examples for other providers:
# For Cloudflare Workers AI:
# API_KEY=your_cloudflare_api_token
# URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# MODEL=@cf/zai-org/glm-4.7-flash

# For Groq:
# API_KEY=gsk_...
# URL=https://api.groq.com/openai/v1
# MODEL=openai/gpt-oss-20b

# For OpenAI:
# API_KEY=sk-...
# URL=https://api.openai.com/v1
# MODEL=gpt-4o-mini

# For Ollama / Local proxy:
# API_KEY=ollama
# URL=http://localhost:11434/v1
# MODEL=llama3

# ── GitHub API ─────────────────────────────────────────────────────────────────
# Optional but strongly recommended (raises rate limit from 60 → 5,000 req/hr)
GITHUB_TOKEN=your_github_personal_access_token_here

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
