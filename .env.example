# ── LLM Provider (OpenRouter / Groq / OpenAI) ──────────────────────────────
# For OpenRouter (Recommended for Hamravesh in Iran - no 403 Forbidden geoblock):
OPENROUTER_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct

# Alternative: Groq (Note: Groq directly blocks Iranian IPs on cloud servers)
# GROQ_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=openai/gpt-oss-20b

# ── GitHub API ─────────────────────────────────────────────────────────────────
# Optional but strongly recommended (raises rate limit from 60 → 5,000 req/hr)
# Create at: GitHub → Settings → Developer Settings → Personal Access Tokens
# Scope needed: read:public_repo
GITHUB_TOKEN=ghp_...

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
